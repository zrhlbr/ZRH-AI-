# ZRH AI Enterprise — Production Environment
# Copy to .env on the server. Do not commit real secrets.

NODE_ENV=production
ZRH_AI_IMAGE_TAG=1.2.0
# Rollback: set ZRH_AI_IMAGE_TAG=1.1.0 and restore tree from backups/v1.1.0-final-*

FRONTEND_PORT=3010
BACKEND_PORT=4010

POSTGRES_DB=zrh_ai
POSTGRES_USER=zrh_ai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Model runtime. Prefer Ollama on the same host (or LAN GPU host).
# Example LAN GPU workstation: http://192.168.10.61:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Hybrid Inference V1.0 — keep false until 赵总批准 Production cutover
# Prefer Tailscale laptop URL (never public IP / never expose 11434 to Internet)
HYBRID_INFERENCE_ENABLED=false
HYBRID_ROUTING_MODE=AUTO
LAPTOP_OLLAMA_BASE_URL=
SERVER_OLLAMA_BASE_URL=http://host.docker.internal:11434

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_INITIAL_PASSWORD

WEB_ORIGIN=https://ai.zrhtech.com

CHAT_RAG_ENABLED=true
CHAT_RAG_MIN_SCORE=0.28

# V1.2 Developer Agent runner (required by production compose)
DEV_RUNNER_TOKEN=CHANGE_ME_LONG_RANDOM_DEV_RUNNER_TOKEN
CURSOR_CLOUD_ENABLED=false

# Mail Center V1.0 (do not enable MAIL_DEV_CODE_ENABLED in production)
MAIL_CONFIG_CRYPTO_KEY=CHANGE_ME_PROD_MAIL_CRYPTO_KEY
MAIL_DEV_CODE_ENABLED=false
