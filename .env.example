# ZRH AI Environment Example
# 复制为 .env 并填入真实值。真实 .env 不得提交到 Git。

NODE_ENV=development

# Ports (host side)
FRONTEND_PORT=3010
BACKEND_PORT=4010

# PostgreSQL (独立实例，禁止连接现有 ZRH PostgreSQL)
POSTGRES_HOST=zrh-ai-postgres
POSTGRES_PORT=5440
POSTGRES_DB=zrh_ai
POSTGRES_USER=zrh_ai
POSTGRES_PASSWORD=change_me_strong_password

# Redis (独立实例，禁止连接现有 ZRH Redis)
REDIS_HOST=zrh-ai-redis
REDIS_PORT=6380
REDIS_PASSWORD=change_me_redis_password

# Ollama (Docker 容器访问 Windows 宿主机 Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Security
JWT_SECRET=change_me_jwt_secret

# 超级管理员初始账号（仅首次种子时生效，入库后请立即修改）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_admin_password

# CORS
WEB_ORIGIN=http://localhost:3010
