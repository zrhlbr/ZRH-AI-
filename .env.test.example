# ZRH AI Enterprise — Independent Test Environment (V1.2)
# Copy to .env.test. Do NOT use on production host with production ports/volumes project.
#
# Recommended:
#   docker compose -p zrh-ai-test -f docker-compose.production.yml --env-file .env.test up -d --build
#
# Project name zrh-ai-test isolates volumes from production (zrh-ai).
# Default production images remain 1.1.0; this file pins the test image tag only.

NODE_ENV=production
ZRH_AI_IMAGE_TAG=1.2.0-test

# Offset ports so a co-located test stack does not bind production 3010/4010
FRONTEND_PORT=3011
BACKEND_PORT=4011

POSTGRES_DB=zrh_ai_test
POSTGRES_USER=zrh_ai
POSTGRES_PASSWORD=CHANGE_ME_TEST_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_TEST_REDIS_PASSWORD

OLLAMA_BASE_URL=http://host.docker.internal:11434

JWT_SECRET=CHANGE_ME_TEST_LONG_RANDOM_JWT_SECRET

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TEST_ADMIN_INITIAL_PASSWORD

# Point to test origin / LAN host as needed
WEB_ORIGIN=http://127.0.0.1:3011

CHAT_RAG_ENABLED=true
CHAT_RAG_MIN_SCORE=0.28
