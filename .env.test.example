# ZRH AI Enterprise — Independent Test Environment (V1.2)
# Copy to .env.test. Do NOT use on production host with production ports/volumes project.
#
# Recommended:
#   docker compose -p zrh-ai-test -f docker-compose.production.yml --env-file .env.test up -d --build
#
# Project name zrh-ai-test isolates volumes from production (zrh-ai).
# Default production images remain 1.1.0; this file pins the test image tag only.

NODE_ENV=production
ZRH_AI_IMAGE_TAG=1.2.0-test

# Offset ports so a co-located test stack does not bind production 3010/4010
FRONTEND_PORT=3011
BACKEND_PORT=4011

POSTGRES_DB=zrh_ai_test
POSTGRES_USER=zrh_ai
POSTGRES_PASSWORD=CHANGE_ME_TEST_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_TEST_REDIS_PASSWORD

OLLAMA_BASE_URL=http://host.docker.internal:11434
# Hybrid Inference V1.0 — keep false until test validation + 赵总批准 Production cutover
HYBRID_INFERENCE_ENABLED=false
HYBRID_ROUTING_MODE=AUTO
# Tailscale only — never public IP
LAPTOP_OLLAMA_BASE_URL=http://100.105.217.7:11434
SERVER_OLLAMA_BASE_URL=http://host.docker.internal:11434
HYBRID_LAPTOP_ENABLED=true
HYBRID_SERVER_CPU_ENABLED=true

JWT_SECRET=CHANGE_ME_TEST_LONG_RANDOM_JWT_SECRET

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_TEST_ADMIN_INITIAL_PASSWORD

# Point to test origin / LAN host as needed
WEB_ORIGIN=http://127.0.0.1:3011

CHAT_RAG_ENABLED=true
CHAT_RAG_MIN_SCORE=0.28
# Align ask with chat by default; override only if needed
ASK_RAG_MIN_SCORE=0.28
RAG_MIN_SCORE=0.28
RAG_CACHE_TTL_SEC=60
RAG_ACL_CACHE_TTL_SEC=45
VECTOR_SCAN_LIMIT=5000
OLLAMA_STREAM_TIMEOUT_MS=300000
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10
EMBEDDING_TASK_STALE_MS=900000

# V1.2 P2 Developer Agent runner (test stack)
DEV_RUNNER_TOKEN=dev-runner-local-token
DEV_RUNNER_URL=http://zrh-ai-dev-runner:5055
CURSOR_CLOUD_ENABLED=false
# CURSOR_API_KEY=

# Mail Center V1.0 (test)
MAIL_CONFIG_CRYPTO_KEY=CHANGE_ME_TEST_MAIL_CRYPTO_KEY
# Explicit switch; default off. Set true only for local/devCode fallback tests.
MAIL_DEV_CODE_ENABLED=false
