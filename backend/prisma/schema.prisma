generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 阶段 1 占位模型：用于验证 Prisma ↔ PostgreSQL 连通性。
model SystemMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_meta")
}

// ============ 阶段 2：认证与 RBAC ============

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  displayName  String
  passwordHash String
  status       String         @default("active") // active | disabled
  roleId       Int
  role         Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  conversations Conversation[]
  folders      ConversationFolder[]
  chatParams   ChatParams?
  knowledgeDocuments KnowledgeDocument[]
  knowledgeFolders   KnowledgeFolder[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique // SUPER_ADMIN | ADMIN | USER
  name        String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique // 例如 menu:home / button:user:create / api:system:cpu
  type        String           // MENU | BUTTON | API
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ 阶段 3：AI 对话核心 ============

// 对话分组（预留：阶段后续开放文件夹管理 UI）
model ConversationFolder {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int            @default(0)
  conversations Conversation[]
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@map("conversation_folders")
}

model Conversation {
  id            Int                 @id @default(autoincrement())
  userId        Int
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  model         String // 当前使用的模型（可在聊天中切换，新消息走新模型）
  systemPrompt  String?             @db.Text // 为空时回落到默认 Prompt 模板
  promptCode    String? // 选用的角色 Prompt 模板 code
  pinned        Boolean             @default(false)
  favorite      Boolean             @default(false)
  folderId      Int?
  folder        ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastMessageAt DateTime            @default(now())

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, pinned])
  @@index([userId, favorite])
  @@map("conversations")
}

model Message {
  id               Int          @id @default(autoincrement())
  conversationId   Int
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // user | assistant | system
  content          String       @db.Text
  model            String? // 生成该消息的模型（历史保留）
  promptTokens     Int? // 预留：Token 统计
  completionTokens Int? // 预留：Token 统计
  durationMs       Int? // 生成耗时
  status           String       @default("done") // done | stopped | error
  feedback         String? // like | dislike | null
  createdAt        DateTime     @default(now())

  @@index([conversationId, id])
  @@map("messages")
}

// 模型配置：与 Ollama 实时清单合并后对外提供
model ModelConfig {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Ollama 模型名，如 qwen3:8b
  displayName String
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  params      Json? // 该模型的默认参数覆盖（可选）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("model_configs")
}

// ============ 阶段 4：AI Gateway / Model Registry ============

model AIProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ollama | openai | claude | gemini | kimi | vllm | sglang | mock
  name        String
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  config      Json?    // Provider 运行时配置：baseUrl、apiKey、timeout 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models AIModel[]

  @@map("ai_providers")
}

model AIModel {
  id             Int                @id @default(autoincrement())
  name           String             // 模型名，如 qwen3:8b
  providerCode   String
  provider       AIProvider         @relation(fields: [providerCode], references: [code], onDelete: Cascade)
  displayName    String
  description    String?
  sizeBytes      BigInt?
  digest         String?
  status         String             @default("unknown") // online | offline | loading | error | unknown
  isDefault      Boolean            @default(false)
  enabled        Boolean            @default(true)
  contextLength  Int                @default(8192)
  params         Json?              // 模型默认参数覆盖
  pulledAt       DateTime?
  updatedAt      DateTime           @updatedAt
  createdAt      DateTime           @default(now())

  capabilities   AIModelCapability[]
  healthRecords  ModelHealth[]

  @@unique([providerCode, name])
  @@index([providerCode])
  @@index([enabled])
  @@index([status])
  @@map("ai_models")
}

model ModelCapability {
  id          Int                 @id @default(autoincrement())
  code        String              @unique // code | reasoning | vision | embedding | multilingual
  name        String
  description String?
  models      AIModelCapability[]

  @@map("model_capabilities")
}

model AIModelCapability {
  modelId      Int
  model        AIModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capabilityId Int
  capability   ModelCapability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([modelId, capabilityId])
  @@map("ai_model_capabilities")
}

model ModelHealth {
  id        Int      @id @default(autoincrement())
  modelId   Int
  model     AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  status    String   // online | offline | error
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([modelId, checkedAt])
  @@map("model_health")
}

// Prompt 模板：System / User / Assistant 三类，后续 AI Agent 直接调用
model PromptTemplate {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  role      String // system | user | assistant
  content   String   @db.Text
  isDefault Boolean  @default(false)
  builtin   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompt_templates")
}

// 每个用户的生成参数设置（持久化）
model ChatParams {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  temperature   Float    @default(0.7)
  topP          Float    @default(0.9)
  topK          Int      @default(40)
  repeatPenalty Float    @default(1.1)
  contextLength Int      @default(8192)
  maxTokens     Int      @default(2048)
  seed          Int? // 预留
  updatedAt     DateTime @updatedAt

  @@map("chat_params")
}

// ============ 阶段 5：Knowledge Platform Foundation ============

model KnowledgeFolder {
  id          Int       @id @default(autoincrement())
  parentId    Int?
  parent      KnowledgeFolder? @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeFolder[] @relation("FolderChildren")
  name        String
  description String?
  ownerId     Int
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permission  String    @default("private") // public | company | department | private | role
  sortOrder   Int       @default(0)
  documents   KnowledgeDocument[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
  @@index([ownerId])
  @@map("knowledge_folders")
}

model KnowledgeTag {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  color       String?
  documents   KnowledgeDocumentTag[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("knowledge_tags")
}

model KnowledgeDocumentTag {
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId       Int
  tag         KnowledgeTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("knowledge_document_tags")
}

model KnowledgeDocument {
  id               Int                     @id @default(autoincrement())
  folderId         Int?
  folder           KnowledgeFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title            String
  filename         String
  mimeType         String
  sizeBytes        BigInt
  hash             String                  // SHA-256
  author           String?
  source           String?
  language         String?                 // zh-CN | en-US | my-MM
  ownerId          Int
  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permission       String                  @default("private") // public | company | department | private | role
  status           String                  @default("pending") // pending | parsing | chunked | embedding | indexed | error
  currentVersionId Int?
  versionCount     Int                     @default(0)
  isFavorite       Boolean                 @default(false)
  isDeleted        Boolean                 @default(false)
  deletedAt        DateTime?
  tags             KnowledgeDocumentTag[]
  versions         KnowledgeDocumentVersion[]
  chunks           KnowledgeChunk[]
  tasks            EmbeddingTask[]
  permissions      DocumentPermission[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([folderId])
  @@index([ownerId])
  @@index([status])
  @@index([permission])
  @@index([isDeleted])
  @@index([isFavorite])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int             @default(1)
  storagePath String
  sizeBytes   BigInt
  hash        String
  createdBy   Int
  createdAt   DateTime          @default(now())

  chunks      KnowledgeChunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("knowledge_document_versions")
}

model KnowledgeChunk {
  id          Int                     @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId   Int
  version     KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  page        Int?
  position    Int?                    // 在原文中的字符/字节位置
  language    String?
  tokenCount  Int                     @default(0)
  hash        String                  // 内容哈希，用于去重
  content     String                  @db.Text
  metadata    Json?                   // 预留：标题、段落、表格等
  createdAt   DateTime                @default(now())

  @@unique([versionId, chunkIndex])
  @@index([documentId])
  @@index([versionId])
  @@index([hash])
  @@map("knowledge_chunks")
}

model EmbeddingProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ollama | openai | bge | jina | qwen | gemini
  name        String
  description String?
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  dimension   Int      @default(768)
  config      Json?    // baseUrl、apiKey、model 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("embedding_providers")
}

model VectorProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // pgvector | milvus | qdrant | chroma | faiss | weaviate
  name        String
  description String?
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  config      Json?    // collection、index、connection 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("vector_providers")
}

model EmbeddingTask {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      String            @default("pending") // pending | running | completed | failed
  providerCode String
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([documentId])
  @@index([status])
  @@map("embedding_tasks")
}

model DocumentPermission {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  targetType  String            // role | user | department
  targetId    Int
  permission  String            // read | write | admin
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([documentId, targetType, targetId])
  @@index([documentId])
  @@map("document_permissions")
}
