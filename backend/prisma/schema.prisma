generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 阶段 1 占位模型：用于验证 Prisma ↔ PostgreSQL 连通性。
model SystemMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_meta")
}

// ============ 阶段 2：认证与 RBAC ============

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  displayName  String
  passwordHash String
  /// V1.2：可选登录标识（邮箱 / 手机）
  email        String?        @unique
  phone        String?        @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status       String         @default("active") // active | disabled
  roleId       Int
  role         Role           @relation(fields: [roleId], references: [id])
  departmentId Int?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  conversations Conversation[]
  folders      ConversationFolder[]
  chatParams   ChatParams?
  knowledgeDocuments KnowledgeDocument[]
  knowledgeFolders   KnowledgeFolder[]
  /// V1.2 User Center
  profile           UserProfile?
  loginLogs         UserLoginLog[]
  devices           UserDevice[]
  sessions          UserSession[]
  notifications     UserNotification[]
  passwordResets    PasswordResetToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([departmentId])
  @@map("users")
}

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique // SUPER_ADMIN | ADMIN | USER
  name        String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique // 例如 menu:home / button:user:create / api:system:cpu
  type        String           // MENU | BUTTON | API
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ 阶段 3：AI 对话核心 ============

// 对话分组（预留：阶段后续开放文件夹管理 UI）
model ConversationFolder {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int            @default(0)
  conversations Conversation[]
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@map("conversation_folders")
}

model Conversation {
  id            Int                 @id @default(autoincrement())
  userId        Int
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  model         String // 当前使用的模型（可在聊天中切换，新消息走新模型）
  systemPrompt  String?             @db.Text // 为空时回落到默认 Prompt 模板
  promptCode    String? // 选用的角色 Prompt 模板 code
  pinned        Boolean             @default(false)
  favorite      Boolean             @default(false)
  folderId      Int?
  folder        ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages      Message[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lastMessageAt DateTime            @default(now())

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, pinned])
  @@index([userId, favorite])
  @@map("conversations")
}

model Message {
  id               Int          @id @default(autoincrement())
  conversationId   Int
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String // user | assistant | system
  content          String       @db.Text
  model            String? // 生成该消息的模型（历史保留）
  promptTokens     Int? // 预留：Token 统计
  completionTokens Int? // 预留：Token 统计
  durationMs       Int? // 生成耗时
  status           String       @default("done") // done | stopped | error
  feedback         String? // like | dislike | null
  /// Chat↔RAG：本轮是否命中知识库
  ragHit           Boolean?
  /// Chat↔RAG：引用列表（RagCitation[]）
  citations        Json?
  /// Chat↔RAG：改写后的查询（审计）
  rewrittenQuery   String?
  createdAt        DateTime     @default(now())

  @@index([conversationId, id])
  @@map("messages")
}

// 模型配置：与 Ollama 实时清单合并后对外提供
model ModelConfig {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Ollama 模型名，如 qwen3:8b
  displayName String
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  params      Json? // 该模型的默认参数覆盖（可选）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("model_configs")
}

// ============ 阶段 4：AI Gateway / Model Registry ============

model AIProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ollama | openai | claude | gemini | kimi | vllm | sglang | mock
  name        String
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  config      Json?    // Provider 运行时配置：baseUrl、apiKey、timeout 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models AIModel[]

  @@map("ai_providers")
}

model AIModel {
  id             Int                @id @default(autoincrement())
  name           String             // 模型名，如 qwen3:8b
  providerCode   String
  provider       AIProvider         @relation(fields: [providerCode], references: [code], onDelete: Cascade)
  displayName    String
  description    String?
  sizeBytes      BigInt?
  digest         String?
  status         String             @default("unknown") // online | offline | loading | error | unknown
  isDefault      Boolean            @default(false)
  enabled        Boolean            @default(true)
  contextLength  Int                @default(8192)
  params         Json?              // 模型默认参数覆盖
  pulledAt       DateTime?
  updatedAt      DateTime           @updatedAt
  createdAt      DateTime           @default(now())

  capabilities   AIModelCapability[]
  healthRecords  ModelHealth[]

  @@unique([providerCode, name])
  @@index([providerCode])
  @@index([enabled])
  @@index([status])
  @@map("ai_models")
}

model ModelCapability {
  id          Int                 @id @default(autoincrement())
  code        String              @unique // code | reasoning | vision | embedding | multilingual
  name        String
  description String?
  models      AIModelCapability[]

  @@map("model_capabilities")
}

model AIModelCapability {
  modelId      Int
  model        AIModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capabilityId Int
  capability   ModelCapability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([modelId, capabilityId])
  @@map("ai_model_capabilities")
}

model ModelHealth {
  id        Int      @id @default(autoincrement())
  modelId   Int
  model     AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  status    String   // online | offline | error
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([modelId, checkedAt])
  @@map("model_health")
}

// Prompt 模板：System / User / Assistant 三类，后续 AI Agent 直接调用
model PromptTemplate {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  role      String // system | user | assistant
  content   String   @db.Text
  isDefault Boolean  @default(false)
  builtin   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompt_templates")
}

// 每个用户的生成参数设置（持久化）
model ChatParams {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  temperature   Float    @default(0.7)
  topP          Float    @default(0.9)
  topK          Int      @default(40)
  repeatPenalty Float    @default(1.1)
  contextLength Int      @default(8192)
  maxTokens     Int      @default(2048)
  seed          Int? // 预留
  updatedAt     DateTime @updatedAt

  @@map("chat_params")
}

// ============ 阶段 5：Knowledge Platform Foundation ============

model KnowledgeFolder {
  id          Int       @id @default(autoincrement())
  parentId    Int?
  parent      KnowledgeFolder? @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeFolder[] @relation("FolderChildren")
  name        String
  description String?
  ownerId     Int
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permission  String    @default("private") // public | company | department | private | role
  sortOrder   Int       @default(0)
  documents   KnowledgeDocument[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
  @@index([ownerId])
  @@map("knowledge_folders")
}

model KnowledgeTag {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  color       String?
  documents   KnowledgeDocumentTag[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("knowledge_tags")
}

model KnowledgeDocumentTag {
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId       Int
  tag         KnowledgeTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("knowledge_document_tags")
}

model KnowledgeDocument {
  id               Int                     @id @default(autoincrement())
  folderId         Int?
  folder           KnowledgeFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title            String
  filename         String
  mimeType         String
  sizeBytes        BigInt
  hash             String                  // SHA-256
  author           String?
  source           String?
  language         String?                 // zh-CN | en-US | my-MM
  ownerId          Int
  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permission       String                  @default("private") // public | company | department | private | role
  status           String                  @default("pending") // pending | parsing | chunked | embedding | indexed | error
  currentVersionId Int?
  versionCount     Int                     @default(0)
  isFavorite       Boolean                 @default(false)
  isDeleted        Boolean                 @default(false)
  deletedAt        DateTime?
  tags             KnowledgeDocumentTag[]
  versions         KnowledgeDocumentVersion[]
  chunks           KnowledgeChunk[]
  tasks            EmbeddingTask[]
  permissions      DocumentPermission[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([folderId])
  @@index([ownerId])
  @@index([status])
  @@index([permission])
  @@index([isDeleted])
  @@index([isFavorite])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int             @default(1)
  storagePath String
  sizeBytes   BigInt
  hash        String
  createdBy   Int
  createdAt   DateTime          @default(now())

  chunks      KnowledgeChunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("knowledge_document_versions")
}

model KnowledgeChunk {
  id          Int                     @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId   Int
  version     KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  page        Int?
  position    Int?                    // 在原文中的字符/字节位置
  language    String?
  tokenCount  Int                     @default(0)
  hash        String                  // 内容哈希，用于去重
  content     String                  @db.Text
  metadata    Json?                   // 预留：标题、段落、表格等
  createdAt   DateTime                @default(now())

  @@unique([versionId, chunkIndex])
  @@index([documentId])
  @@index([versionId])
  @@index([hash])
  @@map("knowledge_chunks")
}

model EmbeddingProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ollama | openai | bge | jina | qwen | gemini
  name        String
  description String?
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  dimension   Int      @default(768)
  config      Json?    // baseUrl、apiKey、model 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("embedding_providers")
}

model VectorProvider {
  id          Int      @id @default(autoincrement())
  code        String   @unique // pgvector | milvus | qdrant | chroma | faiss | weaviate
  name        String
  description String?
  enabled     Boolean  @default(true)
  isDefault   Boolean  @default(false)
  config      Json?    // collection、index、connection 等
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("vector_providers")
}

model EmbeddingTask {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      String            @default("pending") // pending | running | completed | failed
  providerCode String
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([documentId])
  @@index([status])
  @@map("embedding_tasks")
}

model DocumentPermission {
  id          Int               @id @default(autoincrement())
  documentId  Int
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  targetType  String            // role | user | department
  targetId    Int
  permission  String            // read | write | admin
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([documentId, targetType, targetId])
  @@index([documentId])
  @@map("document_permissions")
}

// ============ 阶段 6：Enterprise RAG Engine ============

model RagSynonym {
  id        Int      @id @default(autoincrement())
  term      String
  synonyms  String   @db.Text // JSON string array
  language  String   @default("zh-CN") // zh-CN | en-US | my-MM | *
  category  String   @default("synonym") // synonym | abbreviation | business
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([term, language, category])
  @@index([enabled, category])
  @@map("rag_synonyms")
}

model RagQueryLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  conversationId  Int?
  originalQuery   String   @db.Text
  rewrittenQuery  String   @db.Text
  mode            String
  retrieveCount   Int      @default(0)
  rerankCount     Int      @default(0)
  citationCount   Int      @default(0)
  hitRate         Float?
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
  @@map("rag_query_logs")
}

// ============ 阶段 7：Agent Center ============

model Agent {
  id                     Int                 @id @default(autoincrement())
  code                   String              @unique
  name                   String
  description            String?
  avatar                 String?
  systemPrompt           String              @db.Text
  status                 String              @default("active") // draft | active | disabled
  enabled                Boolean             @default(true)
  version                String              @default("1.0.0")
  defaultModel           String?
  defaultKnowledgeScope  String? // all | JSON folderIds
  roleAccess             String? // JSON role codes；null/空 = 持有 api:agents:chat 即可
  sortOrder              Int                 @default(0)
  builtin                Boolean             @default(false)
  skills                 AgentSkillBinding[]
  memories               AgentMemory[]
  logs                   AgentRunLog[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([enabled, status])
  @@index([sortOrder])
  @@map("agents")
}

model AgentSkill {
  id          Int                 @id @default(autoincrement())
  code        String              @unique // knowledge_search | rag | chat | summarize | translate | code | image | video | tool
  name        String
  description String?
  category    String              @default("core") // core | media | tool
  enabled     Boolean             @default(true)
  reserved    Boolean             @default(false)
  agents      AgentSkillBinding[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("agent_skills")
}

model AgentSkillBinding {
  agentId Int
  agent   Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId Int
  skill   AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  config  Json?

  @@id([agentId, skillId])
  @@map("agent_skill_bindings")
}

model AgentMemory {
  id             Int      @id @default(autoincrement())
  agentId        Int
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId         Int
  conversationId Int?
  kind           String   @default("note") // conversation | knowledge | note
  key            String?
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agentId, userId, createdAt])
  @@index([conversationId])
  @@map("agent_memories")
}

model AgentRunLog {
  id           Int      @id @default(autoincrement())
  agentId      Int
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId       Int
  skillCode    String?
  inputSummary String?
  status       String   // success | error | routed
  latencyMs    Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_run_logs")
}

// ============ 阶段 8：MCP & Tool Calling Platform ============

model ToolCategory {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  sortOrder   Int              @default(0)
  tools       ToolDefinition[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("tool_categories")
}

model ToolDefinition {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  description  String?
  categoryId   Int
  category     ToolCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  version      String        @default("1.0.0")
  enabled      Boolean       @default(true)
  builtin      Boolean       @default(false)
  inputSchema  Json?
  outputSchema Json?
  timeoutMs    Int           @default(15000)
  maxRetries   Int           @default(1)
  roleAccess   String? // JSON role codes
  executorCode String // runtime handler key
  config       Json?
  logs         ToolRunLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([enabled])
  @@index([categoryId])
  @@map("tool_definitions")
}

model ToolRunLog {
  id        Int            @id @default(autoincrement())
  toolId    Int
  tool      ToolDefinition @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    Int
  agentCode String?
  status    String // success | error | timeout
  input     Json?
  output    Json?
  error     String?
  latencyMs Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([toolId, createdAt])
  @@index([userId, createdAt])
  @@map("tool_run_logs")
}

model McpServer {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  description String?
  transport   String       @default("stub") // stub | stdio | http | sse
  endpoint    String?
  enabled     Boolean      @default(false)
  status      String       @default("offline") // online | offline | error | reserved
  version     String       @default("0.1.0")
  builtin     Boolean      @default(true)
  reserved    Boolean      @default(true)
  roleAccess  String?
  config      Json?
  sessions    McpSession[]
  logs        McpRunLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([enabled, status])
  @@map("mcp_servers")
}

model McpSession {
  id        Int       @id @default(autoincrement())
  serverId  Int
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    Int
  status    String    @default("connected") // connected | disconnected | error
  metadata  Json?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([serverId, userId])
  @@map("mcp_sessions")
}

model McpRunLog {
  id        Int       @id @default(autoincrement())
  serverId  Int
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    Int
  action    String
  status    String
  detail    String?
  latencyMs Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([serverId, createdAt])
  @@map("mcp_run_logs")
}

// ============ 阶段 9：Workflow Engine ============

model WorkflowCategory {
  id          Int                  @id @default(autoincrement())
  code        String               @unique
  name        String
  description String?
  sortOrder   Int                  @default(0)
  workflows   WorkflowDefinition[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("workflow_categories")
}

model WorkflowDefinition {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  description String?
  categoryId  Int
  category    WorkflowCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  version     String              @default("1.0.0")
  enabled     Boolean             @default(true)
  builtin     Boolean             @default(false)
  template    Boolean             @default(false)
  status      String              @default("active") // draft | active | disabled
  graph       Json // { nodes: [], edges: [] }
  variables   Json? // variable schema / defaults
  roleAccess  String?
  timeoutMs   Int                 @default(120000)
  maxRetries  Int                 @default(0)
  runs        WorkflowRun[]
  schedules   WorkflowSchedule[]
  audits      WorkflowAuditLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([enabled, status])
  @@index([categoryId])
  @@index([template])
  @@map("workflow_definitions")
}

model WorkflowRun {
  id         Int               @id @default(autoincrement())
  workflowId Int
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId     Int
  status     String            @default("pending") // pending | queued | running | paused | waiting_approval | success | error | cancelled | timeout
  mode       String            @default("sync") // sync | async | queue
  trigger    String            @default("manual") // manual | schedule | cron | event
  input      Json?
  output     Json?
  variables  Json?
  error      String?
  latencyMs  Int               @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime          @default(now())
  nodeRuns   WorkflowNodeRun[]
  audits     WorkflowAuditLog[]

  @@index([workflowId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowNodeRun {
  id         Int         @id @default(autoincrement())
  runId      Int
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  nodeType   String
  status     String // pending | running | success | error | skipped | waiting
  input      Json?
  output     Json?
  error      String?
  latencyMs  Int         @default(0)
  attempt    Int         @default(1)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([runId, createdAt])
  @@map("workflow_node_runs")
}

model WorkflowSchedule {
  id           Int                 @id @default(autoincrement())
  workflowId   Int
  workflow     WorkflowDefinition  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name         String
  enabled      Boolean             @default(true)
  kind         String              @default("cron") // once | cron | interval | event_reserved
  cronExpr     String?
  intervalSec  Int?
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  config       Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([enabled, nextRunAt])
  @@index([workflowId])
  @@map("workflow_schedules")
}

model WorkflowAuditLog {
  id         Int                 @id @default(autoincrement())
  workflowId Int
  workflow   WorkflowDefinition  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId      Int?
  run        WorkflowRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  userId     Int
  action     String
  detail     String?
  createdAt  DateTime            @default(now())

  @@index([workflowId, createdAt])
  @@index([runId])
  @@map("workflow_audit_logs")
}

// ============ 阶段 10：Business Integration Platform ============

model Company {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model BusinessSystem {
  id                    Int                      @id @default(autoincrement())
  code                  String                   @unique // zrh_accounting | zrhpay | zrh_router | knowledge | document
  name                  String
  description           String?
  kind                  String // accounting | payment | router | knowledge | document
  enabled               Boolean                  @default(true)
  status                String                   @default("online") // online | offline | degraded | reserved
  version               String                   @default("1.0.0")
  readOnlyDefault       Boolean                  @default(true)
  writeRequiresApproval Boolean                  @default(true)
  roleAccess            String? // JSON role codes
  companyCode           String? // optional company scope
  config                Json?
  connectors            BusinessConnector[]
  workflows             BusinessSystemWorkflow[]
  audits                BusinessAuditLog[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([enabled, status])
  @@index([kind])
  @@map("business_systems")
}

model BusinessConnector {
  id           Int            @id @default(autoincrement())
  systemId     Int
  system       BusinessSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  code         String
  name         String
  transport    String         @default("stub") // stub | mcp | tool
  endpoint     String?
  enabled      Boolean        @default(true)
  status       String         @default("ready") // ready | offline | error | reserved
  healthStatus String         @default("unknown") // healthy | degraded | unhealthy | unknown
  config       Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([systemId, code])
  @@index([enabled, status])
  @@map("business_connectors")
}

model BusinessSystemWorkflow {
  id                Int            @id @default(autoincrement())
  systemId          Int
  system            BusinessSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  actionCode        String // qa | balance_query | wallet_query | device_status | ...
  workflowCode      String
  name              String
  isDefault         Boolean        @default(false)
  requiresApproval  Boolean        @default(false)
  readOnly          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([systemId, actionCode])
  @@index([workflowCode])
  @@map("business_system_workflows")
}

model BusinessAuditLog {
  id            Int            @id @default(autoincrement())
  systemId      Int
  system        BusinessSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  userId        Int
  action        String
  workflowCode  String?
  workflowRunId Int?
  status        String
  detail        String?
  departmentId  Int?
  companyCode   String?
  createdAt     DateTime       @default(now())

  @@index([systemId, createdAt])
  @@index([userId, createdAt])
  @@map("business_audit_logs")
}

// ============ V1.2 P1：User Center / Admin / Super Admin ============

model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String?
  avatarUrl   String?
  country     String?
  language    String   @default("zh-CN") // zh-CN | my-MM | en-US
  bio         String?
  timezone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

model UserLoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    String   // username | email | phone
  success   Boolean
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_login_logs")
}

model UserDevice {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  name       String?
  platform   String?
  userAgent  String?
  lastIp     String?
  lastSeenAt DateTime  @default(now())
  trusted    Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String?   @unique
  ip               String?
  userAgent        String?
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_sessions")
}

model UserNotification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  level     String    @default("info") // info | warn | critical
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_notifications")
}

model SystemAnnouncement {
  id          Int       @id @default(autoincrement())
  title       String
  body        String
  locale      String    @default("zh-CN")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("system_announcements")
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  group     String   @default("general") // general | smtp | oauth | cloudflare | ai | license
  secret    Boolean  @default(false)
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("system_configs")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  channel   String    // email | phone | admin
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model VerificationCode {
  id        Int       @id @default(autoincrement())
  target    String    // email or phone
  channel   String    // email | phone
  purpose   String    // register | reset | bind
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([target, purpose, createdAt])
  @@map("verification_codes")
}

/// Mail Center V1.0 — email templates (zh / en / my)
model MailTemplate {
  id          Int      @id @default(autoincrement())
  /// register_code | login_code | forgot_password | change_email | invite_user | invite_employee | org_invite | system_notice | welcome
  type        String
  /// zh-CN | en-US | my-MM
  locale      String
  subject     String
  htmlBody    String
  textBody    String
  /// JSON array of placeholder names, e.g. ["code","ttlMinutes","appName"]
  variables   String   @default("[]")
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  updatedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, locale])
  @@index([type, enabled])
  @@map("mail_templates")
}

/// Mail Center V1.0 — send audit log (no secrets / no raw codes)
model MailSendLog {
  id              Int       @id @default(autoincrement())
  /// Masked recipient, e.g. a***@example.com
  toMasked        String
  templateType    String
  /// queued | sending | sent | failed
  status          String
  provider        String    @default("smtp")
  messageId       String?
  attempts        Int       @default(1)
  errorCode       String?
  /// Sanitized error message (no secrets)
  errorMessage    String?
  userId          Int?
  requestIp       String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([createdAt])
  @@index([templateType, status])
  @@index([userId])
  @@map("mail_send_logs")
}



model InviteCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  roleCode  String    @default("USER")
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  enabled   Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("invite_codes")
}
